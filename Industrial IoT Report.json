    {
        "id": "d7b181efe08af8e7",
        "type": "function",
        "z": "5cf52b14fecc3a56",
        "name": "",
        "func": "var start_date = msg.payload.start_date\nvar finish_date = msg.payload.finish_date\n\nflow.set('start_date', start_date)\nflow.set('finish_date', finish_date)\n\nvar s_date = new Date(start_date).getDate();\nvar s_month = new Date(start_date).getMonth() + 1;\nvar s_year = new Date(start_date).getFullYear();\n\nvar f_date = new Date(finish_date).getDate();\nvar f_month = new Date(finish_date).getMonth() + 1;\nvar f_year = new Date(finish_date).getFullYear();\n\nstart_date = s_year + '-' + s_month + '-' + s_date\nfinish_date = f_year + '-' + f_month + '-' + f_date\n\nvar query = \"call breakdown_report('\" + start_date + \"','\" + finish_date + \"');\"\n\nmsg.topic = String(query)\n\nreturn msg;",
