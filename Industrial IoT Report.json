        "format": "<html>\n   <head>\n          <title> {{ title }}</title>\n   </head>\n   <body>\n        <table border = \"1\">\n            <tr>\n                <th>Breakdown Start</th>\n                <th>Breakdown Finish</th>\n                <th>Remark</th>\n                <th>Time</th>\n            </tr>\n            <tr ng-repeat = \"x in msg.payload[0]\">\n                <td align=\"center\">{{x.breakdown_start}}</td>\n                <td align=\"center\">{{x.breakdown_finish}}</td>\n                <td align=\"center\">{{x.remark}}</td>\n                <td align=\"center\">{{x.breakdown_time}}</td>\n            </tr>\n        </table>\n   </body>\n</html>",
